{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moerand-alerts",
  "main": "worker/src/trade-notification-entry.js",
  "compatibility_date": "2026-07-22",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ALERT_COORDINATOR", "class_name": "AlertCoordinator" }]
  },
  "exports": { "AlertCoordinator": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "APP_ORIGIN": "https://mosaprajb.github.io",
    "APP_URL": "https://mosaprajb.github.io/MOE-AI/",
    "VAPID_PUBLIC_KEY": "BP7XvNvwNZqLog4ldUcwEmMaXieeKD37sBddfWk5BbsC0mXRl09dS-kw-C__JnSUDGYaTDVKcKYJURIlac9T98c",
    "VAPID_SUBJECT": "https://mosaprajb.github.io/MOE-AI/",
    "MOE_TRADING_MODE_DEFAULT": "SANDBOX",
    "MOE_TRADING_SESSION_POLICY_DEFAULT": "ALL_SESSIONS",
    "MOE_SESSION_ALERTS_ENABLED": "true",
    "MOE_TRADE_ALERTS_ENABLED": "true",
    "MOE_DIRECTION_POLICY": "LONG_ONLY",
    "MOE_ALLOW_SHORT_ENTRIES": "false",
    "MOE_LIVE_PIN_CONTROL_ENABLED": "true",
    "MOE_LIVE_PIN_MAX_ATTEMPTS": "5",
    "MOE_LIVE_PIN_LOCKOUT_MINUTES": "15",
    "MOE_LIVE_MODE_UNLOCKED": "false",
    "MOE_LIVE_EXECUTION_IMPLEMENTED": "true",
    "WEBULL_ENVIRONMENT": "sandbox",
    "WEBULL_SANDBOX_ENABLED": "true",
    "WEBULL_SANDBOX_ORDER_SUBMISSION": "true",
    "WEBULL_AUTO_SUBMIT_SANDBOX": "true",
    "WEBULL_AUTOMATION_ARMED": "true",
    "WEBULL_PROTECTED_ORDERS": "true",
    "WEBULL_READ_ONLY_SYNC": "true",
    "WEBULL_LIVE_API_BASE_URL": "https://api.webull.com",
    "WEBULL_LIVE_TRADING": "false",
    "WEBULL_LIVE_ORDER_SUBMISSION": "false",
    "WEBULL_LIVE_AUTOMATION_ARMED": "false",
    "WEBULL_LIVE_KILL_SWITCH": "true",
    "WEBULL_LIVE_MAX_QUANTITY": "1",
    "WEBULL_LIVE_MAX_NOTIONAL": "100",
    "WEBULL_BOOTSTRAP_ENABLED": "false",
    "WEBULL_MAX_QUANTITY": "1",
    "WEBULL_MAX_NOTIONAL": "1000",
    "MOE_MAX_OPEN_POSITIONS": "2",
    "MOE_MAX_DAILY_TRADES": "4",
    "MOE_MAX_PORTFOLIO_RISK_PERCENT": "1",
    "MOE_MAX_CORRELATED_POSITIONS": "1",
    "MOE_MAX_SECTOR_POSITIONS": "1",
    "MOE_MAX_DAILY_LOSS_PERCENT": "1",
    "MOE_MAX_SYMBOL_CONCENTRATION_PERCENT": "35",
    "MOE_MAX_SECTOR_EXPOSURE_PERCENT": "50",
    "MOE_MAX_OPEN_RISK_PERCENT": "1",
    "MOE_PORTFOLIO_ACCOUNT_STALE_SECONDS": "300",
    "AUTO_SCANNER_ENABLED": "true",
    "AUTO_SCANNER_TRADING_HOURS": "AUTO",
    "AUTO_SCANNER_OVERNIGHT_ENABLED": "true",
    "AUTO_SCANNER_ALLOW_DELAYED_OVERNIGHT_SANDBOX": "true",
    "AUTO_SCANNER_PROFILES": "1:15,5:60",
