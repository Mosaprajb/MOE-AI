    "AUTO_SCANNER_MIN_RVOL_NIGHT": "0.25",
    "AUTO_SCANNER_MAX_DRIFT_CORE_PERCENT": "1.50",
    "AUTO_SCANNER_MAX_DRIFT_EXTENDED_PERCENT": "1.00",
    "AUTO_SCANNER_MAX_DRIFT_NIGHT_PERCENT": "0.80",
    "SMART_MONEY_OBSERVATION_ENABLED": "true",
    "SMART_MONEY_OBSERVATION_TIMEFRAME": "5m",
