{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moerand-alerts",
  "main": "worker/src/entry.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ALERT_COORDINATOR",
        "class_name": "AlertCoordinator"
      }
    ]
  },
  "exports": {
    "AlertCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_ORIGIN": "https://mosaprajb.github.io",
    "APP_URL": "https://mosaprajb.github.io/MOE-AI/",
    "VAPID_PUBLIC_KEY": "BP7XvNvwNZqLog4ldUcwEmMaXieeKD37sBddfWk5BbsC0mXRl09dS-kw-C__JnSUDGYaTDVKcKYJURIlac9T98c",
    "VAPID_SUBJECT": "https://mosaprajb.github.io/MOE-AI/",
    "WEBULL_ENVIRONMENT": "sandbox",
    "WEBULL_SANDBOX_ENABLED": "true",
    "WEBULL_SANDBOX_ORDER_SUBMISSION": "true",
    "WEBULL_AUTO_SUBMIT_SANDBOX": "true",
    "WEBULL_AUTOMATION_ARMED": "false",
    "WEBULL_PROTECTED_ORDERS": "true",
    "WEBULL_READ_ONLY_SYNC": "true",
    "WEBULL_LIVE_TRADING": "false",
    "WEBULL_MAX_QUANTITY": "1",
    "WEBULL_MAX_NOTIONAL": "100",
    "AUTO_SCANNER_ENABLED": "false",
    "AUTO_SCANNER_TRADING_HOURS": "AUTO",
    "AUTO_SCANNER_OVERNIGHT_ENABLED": "true",
    "AUTO_SCANNER_ALLOW_DELAYED_OVERNIGHT_SANDBOX": "true",
    "AUTO_SCANNER_MIN_SCORE": "78",
    "AUTO_SCANNER_MIN_SCORE_EXTENDED": "83",
    "AUTO_SCANNER_MIN_SCORE_NIGHT": "88",
    "AUTO_SCANNER_MIN_RVOL_CORE": "0.25",
    "AUTO_SCANNER_MIN_RVOL_EXTENDED": "0.50",
    "AUTO_SCANNER_MIN_RVOL_NIGHT": "0.80",
    "AUTO_SCANNER_MAX_DRIFT_CORE_PERCENT": "0.80",
    "AUTO_SCANNER_MAX_DRIFT_EXTENDED_PERCENT": "0.60",
    "AUTO_SCANNER_MAX_DRIFT_NIGHT_PERCENT": "0.40",
    "MOE_LEARNING_ENABLED": "true",
    "MOE_LEARNING_MINIMUM_SAMPLE": "8",
    "MOE_LEARNING_REFRESH_MINUTES": "15",
    "MOE_LEARNING_AUTO_APPLY": "false",
    "MOE_LEARNING_LIVE_TRADING_CHANGES": "false"
  }
}
