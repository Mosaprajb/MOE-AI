{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moerand-alerts-sandbox",
  "main": "worker/src/sandbox-simulation-rpc-entry.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "ALERT_COORDINATOR", "class_name": "AlertCoordinator" },
      { "name": "SIMULATION_DRIVER", "class_name": "SimulationDriver" }
    ]
  },
  "exports": {
    "AlertCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "SimulationDriver": { "type": "durable-object", "storage": "sqlite" }
  },
  "secrets": {
    "required": [
      "MOE_WEBHOOK_SECRET",
      "ALPACA_KEY_ID",
      "ALPACA_SECRET_KEY",
      "WEBULL_APP_KEY",
      "WEBULL_APP_SECRET",
      "WEBULL_ACCESS_TOKEN",
      "WEBULL_ACCOUNT_ID"
    ]
  },
  "vars": {
    "CF_WORKER_NAME": "moerand-alerts-sandbox",
    "APP_ORIGIN": "https://mosaprajb.github.io",
    "APP_URL": "https://mosaprajb.github.io/MOE-AI/",
    "MOE_RUNTIME_ENVIRONMENT": "SANDBOX_PILOT",
    "MOE_SANDBOX_DEFAULT_CAPITAL": "25000",
    "MOE_SANDBOX_PILOT_ENABLED": "false",
    "MOE_SANDBOX_PILOT_OBSERVABILITY_ENABLED": "true",
    "MOE_SANDBOX_PILOT_MAX_SUBMISSIONS_TOTAL": "1",
    "MOE_SANDBOX_PILOT_EVENT_LIMIT": "1000",
    "MOE_SIMULATION_ENABLED": "true",
    "MOE_SIMULATION_SYMBOLS": "SPY,QQQ,NVDA,AAPL,MSFT,AMD,TSLA,AMZN,META,GOOGL",
    "MOERAND_SIMULATION_ATR_PERIOD": "10",
    "MOERAND_SIMULATION_KEY_VALUE": "1",
    "MOERAND_SIMULATION_MIN_REENTRY_BARS": "2",
    "MOERAND_SIMULATION_REQUIRE_BULLISH_CONFIRMATION": "true",
    "MOE_STRATEGY_FUSION_V2_MAX_DAILY_TRADES": "1",
    "MOE_STRATEGY_FUSION_V2_MAX_CONCURRENT_POSITIONS": "1",
    "MOE_STRATEGY_MOERAND_SIMPLE_INTERNAL_MAX_DAILY_TRADES": "2",
    "MOE_STRATEGY_MOERAND_SIMPLE_INTERNAL_MAX_CONCURRENT_POSITIONS": "1",
    "MOE_STRATEGY_MOERAND_SCALP_INTERNAL_MAX_DAILY_TRADES": "20",
    "MOE_STRATEGY_MOERAND_SCALP_INTERNAL_MAX_CONCURRENT_POSITIONS": "1",
    "MOE_TRADING_MODE_DEFAULT": "SANDBOX",
    "MOE_TRADING_SESSION_POLICY_DEFAULT": "ALL_SESSIONS",
    "MOE_SESSION_ALERTS_ENABLED": "true",
    "MOE_TRADE_ALERTS_ENABLED": "true",
    "MOE_DIRECTION_POLICY": "LONG_ONLY",
    "MOE_ALLOW_SHORT_ENTRIES": "false",
    "MOE_LIVE_PIN_CONTROL_ENABLED": "true",
    "MOE_LIVE_PIN_MAX_ATTEMPTS": "5",
    "MOE_LIVE_PIN_LOCKOUT_MINUTES": "15",
    "MOE_LIVE_MODE_UNLOCKED": "false",
    "MOE_LIVE_EXECUTION_IMPLEMENTED": "false",
    "WEBULL_ENVIRONMENT": "sandbox",
    "WEBULL_API_BASE_URL": "https://api.sandbox.webull.com",
    "WEBULL_SANDBOX_ENABLED": "true",
    "WEBULL_SANDBOX_ORDER_SUBMISSION": "true",
    "WEBULL_AUTO_SUBMIT_SANDBOX": "true",
    "WEBULL_AUTOMATION_ARMED": "true",
    "WEBULL_PROTECTED_ORDERS": "true",
    "WEBULL_READ_ONLY_SYNC": "true",
    "WEBULL_MAX_QUANTITY": "1",
    "WEBULL_MAX_NOTIONAL": "1000",
    "MOE_TRADING_CONTROL_MIN_SCORE": "68",
    "MOE_TRADING_CONTROL_MIN_CONFIDENCE": "68",
    "WEBULL_LIVE_API_BASE_URL": "https://api.webull.com",
    "WEBULL_LIVE_TRADING": "false",
    "WEBULL_LIVE_ORDER_SUBMISSION": "false",
    "WEBULL_LIVE_AUTOMATION_ARMED": "false",
    "WEBULL_LIVE_KILL_SWITCH": "true",
    "WEBULL_BOOTSTRAP_ENABLED": "false",
    "MOE_MAX_OPEN_POSITIONS": "1",
    "MOE_MAX_DAILY_TRADES": "1",
    "MOE_MAX_PORTFOLIO_RISK_PERCENT": "0.5",
    "MOE_MAX_CORRELATED_POSITIONS": "1",
    "MOE_MAX_SECTOR_POSITIONS": "1",
    "MOE_MAX_DAILY_LOSS_PERCENT": "0.5",
    "MOE_MAX_SYMBOL_CONCENTRATION_PERCENT": "25",
    "MOE_MAX_SECTOR_EXPOSURE_PERCENT": "35",
    "MOE_MAX_OPEN_RISK_PERCENT": "0.5",
    "MOE_PORTFOLIO_ACCOUNT_STALE_SECONDS": "120",
    "AUTO_SCANNER_ENABLED": "true",
    "AUTO_SCANNER_TRADING_HOURS": "AUTO",
    "AUTO_SCANNER_OVERNIGHT_ENABLED": "false",
    "AUTO_SCANNER_ALLOW_DELAYED_OVERNIGHT_SANDBOX": "false",
    "AUTO_SCANNER_PROFILES": "5:60",
    "AUTO_SCANNER_PREPARE_LIMIT": "10",
    "AUTO_SCANNER_MAX_SUBMISSIONS_PER_RUN": "1",
    "AUTO_SCANNER_ENGINE_MIN_SCORE": "68",
    "AUTO_SCANNER_MIN_SCORE": "68",
    "AUTO_SCANNER_MIN_SCORE_EXTENDED": "72",
    "AUTO_SCANNER_MIN_SCORE_NIGHT": "100",
    "AUTO_SCANNER_MIN_RVOL_CORE": "0.25",
    "AUTO_SCANNER_MIN_RVOL_EXTENDED": "0.35",
    "AUTO_SCANNER_MIN_RVOL_NIGHT": "10",
    "AUTO_SCANNER_MAX_DRIFT_CORE_PERCENT": "1.00",
    "AUTO_SCANNER_MAX_DRIFT_EXTENDED_PERCENT": "0.75",
    "AUTO_SCANNER_MAX_DRIFT_NIGHT_PERCENT": "0.25",
    "SMART_SCANNER_SCHEDULER_ENABLED": "true",
    "SMART_SCANNER_PREMARKET_INTERVAL_SECONDS": "60",
    "SMART_SCANNER_OPEN_INTERVAL_SECONDS": "20",
    "SMART_SCANNER_LUNCH_INTERVAL_SECONDS": "60",
    "SMART_SCANNER_POWER_HOUR_INTERVAL_SECONDS": "20",
    "SMART_SCANNER_AFTER_HOURS_INTERVAL_SECONDS": "120",
    "SMART_MONEY_OBSERVATION_ENABLED": "true",
    "SMART_MONEY_OBSERVATION_TIMEFRAME": "5m",
    "SMART_MONEY_OBSERVATION_LIMIT": "10",
    "SMART_MONEY_OBSERVATION_TOP_RESULTS": "5",
    "SMT_DIVERGENCE_ENABLED": "true",
    "SMT_DEFAULT_COMPARISON_SYMBOL": "SPY",
    "SMT_FALLBACK_COMPARISON_SYMBOL": "QQQ",
    "SMT_MINIMUM_BARS": "30",
    "SMT_CORRELATION_LOOKBACK": "60",
    "SMT_MINIMUM_CORRELATION": "0.45",
    "MOE_AI_MIN_SCORE_CORE": "68",
    "MOE_AI_MIN_SCORE_EXTENDED": "72",
    "MOE_AI_MIN_SCORE_NIGHT": "100",
    "MOE_AI_MIN_RISK_REWARD": "2",
    "MOE_LEARNING_ENABLED": "true",
    "MOE_LEARNING_MINIMUM_SAMPLE": "8",
    "MOE_LEARNING_REFRESH_MINUTES": "15",
    "MOE_LEARNING_AUTO_APPLY": "false",
    "MOE_LEARNING_LIVE_TRADING_CHANGES": "false"
  }
}
