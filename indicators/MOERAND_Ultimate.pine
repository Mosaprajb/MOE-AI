//@version=6
// MOERAND Ultimate — original Smart Money Concepts indicator
// Inspired by common SMC concepts; not affiliated with or copied from LuxAlgo.
indicator("MOERAND Ultimate", "MOERAND Ultimate", overlay = true, max_boxes_count = 20, max_lines_count = 30, max_labels_count = 50)

//=============================================================================
// SETTINGS
//=============================================================================
string gStructure = "1. Smart Money Structure"
int swingLen = input.int(5, "Swing Length", minval = 2, maxval = 20, group = gStructure)
bool showStructure = input.bool(true, "Show BOS / CHOCH", group = gStructure)
bool showSwings = input.bool(false, "Show Swing Labels", group = gStructure)
bool useHtfBias = input.bool(true, "Use Higher-Timeframe Bias", group = gStructure)
string biasTf = input.timeframe("60", "Bias Timeframe", group = gStructure)
int minScore = input.int(70, "Minimum Signal Score", minval = 40, maxval = 100, group = gStructure)

string gBlocks = "2. Order Blocks"
bool showBlocks = input.bool(true, "Show Order Blocks", group = gBlocks)
int blockLookback = input.int(12, "Search Back Bars", minval = 3, maxval = 30, group = gBlocks)
int maxBlocks = input.int(6, "Maximum Blocks", minval = 1, maxval = 10, group = gBlocks)
float blockAtr = input.float(1.5, "Maximum Block Size (ATR)", minval = 0.25, maxval = 5, step = 0.25, group = gBlocks)

string gLiquidity = "3. Liquidity"
bool showLiquidity = input.bool(true, "Show Liquidity Levels", group = gLiquidity)
int liquidityLookback = input.int(30, "Equal High/Low Lookback", minval = 10, maxval = 100, group = gLiquidity)
float equalTolerance = input.float(0.15, "Equal Level Tolerance (ATR)", minval = 0.02, maxval = 0.5, step = 0.01, group = gLiquidity)
bool requireSweep = input.bool(false, "Require Liquidity Sweep For Signal", group = gLiquidity)

string gRisk = "4. Entries and Risk"
int atrLen = input.int(14, "ATR Length", minval = 5, maxval = 50, group = gRisk)
float stopAtr = input.float(1.2, "Stop Distance (ATR)", minval = 0.3, maxval = 4, step = 0.1, group = gRisk)
float targetR = input.float(2.0, "Take Profit (R Multiple)", minval = 0.5, maxval = 6, step = 0.1, group = gRisk)
bool oneSignalPerSide = input.bool(true, "One Active Signal Per Side", group = gRisk)

string gDisplay = "5. Display and Alerts / MOE AI Webhook"
bool showPanel = input.bool(true, "Show Information Panel", group = gDisplay)
bool showTargets = input.bool(true, "Show SL / TP", group = gDisplay)
bool enableAlerts = input.bool(true, "Enable Dynamic Alerts", group = gDisplay)
bool enableWebhook = input.bool(true, "Enable MOE AI Webhook", group = gDisplay)
string webhookSecret = input.string("", "MOE Webhook Secret", group = gDisplay)
bool requestSandbox = input.bool(false, "Request Sandbox Submission", group = gDisplay)
bool sendWebhookTest = input.bool(false, "Send One-Time Webhook Test", group = gDisplay)

//=============================================================================
// HELPERS
//=============================================================================
f_price(float n) =>
    str.tostring(n, format.mintick)

f_num(float n) =>
    str.tostring(n, format.mintick)

f_json(string side, string source, float entry, float stop, float target, int score, int signalTime) =>
    string msg = "{"
    msg += "\"secret\":\"" + webhookSecret + "\","
    msg += "\"symbol\":\"" + syminfo.ticker + "\","
    msg += "\"side\":\"" + side + "\","
    msg += "\"orderType\":\"LIMIT\","
    msg += "\"limitPrice\":" + f_num(entry) + ","
    msg += "\"marketPrice\":" + f_num(close) + ","
    msg += "\"stopLoss\":" + f_num(stop) + ","
    msg += "\"takeProfit\":" + f_num(target) + ","
    msg += "\"source\":\"" + source + "\","
    msg += "\"signalId\":\"" + source + "-" + syminfo.ticker + "-" + str.tostring(signalTime) + "\","
    msg += "\"submitSandbox\":" + (requestSandbox ? "true" : "false") + ","
    msg += "\"context\":{\"score\":" + str.tostring(score) + ",\"timeframe\":\"" + timeframe.period + "\"}"
    msg += "}"
    msg

//=============================================================================
// CORE MARKET STRUCTURE
//=============================================================================
float atr = ta.atr(atrLen)
float htfFast = request.security(syminfo.tickerid, biasTf, ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfSlow = request.security(syminfo.tickerid, biasTf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
float htfRsi = request.security(syminfo.tickerid, biasTf, ta.rsi(close, 14)[1], barmerge.gaps_off, barmerge.lookahead_on)
bool htfBull = htfFast > htfSlow and htfRsi >= 50
bool htfBear = htfFast < htfSlow and htfRsi <= 50

float swingHigh = ta.pivothigh(high, swingLen, swingLen)
float swingLow = ta.pivotlow(low, swingLen, swingLen)
var float lastHigh = na
var float lastLow = na
var float previousHigh = na
var float previousLow = na
if not na(swingHigh)
    previousHigh := lastHigh
    lastHigh := swingHigh
if not na(swingLow)
    previousLow := lastLow
    lastLow := swingLow

bool bullishBos = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bool bearishBos = not na(lastLow) and close < lastLow and close[1] >= lastLow
var int structureBias = 0
bool bullishChoch = bullishBos and structureBias == -1
bool bearishChoch = bearishBos and structureBias == 1
if bullishBos
    structureBias := 1
if bearishBos
    structureBias := -1

if showStructure and bullishBos
    label.new(bar_index, low, bullishChoch ? "CHOCH ↑" : "BOS ↑", style = label.style_label_up, color = color.new(color.green, 15), textcolor = color.white, size = size.tiny)
if showStructure and bearishBos
    label.new(bar_index, high, bearishChoch ? "CHOCH ↓" : "BOS ↓", style = label.style_label_down, color = color.new(color.red, 15), textcolor = color.white, size = size.tiny)
if showSwings and not na(swingHigh)
    label.new(bar_index - swingLen, swingHigh, "SH", style = label.style_label_down, color = color.new(color.red, 70), textcolor = color.white, size = size.tiny)
if showSwings and not na(swingLow)
    label.new(bar_index - swingLen, swingLow, "SL", style = label.style_label_up, color = color.new(color.green, 70), textcolor = color.white, size = size.tiny)

//=============================================================================
// ORDER BLOCKS — last opposite candle before a confirmed break
//=============================================================================
var box[] bullBlocks = array.new_box()
var box[] bearBlocks = array.new_box()
var float bullBlockTop = na
var float bullBlockBottom = na
var float bearBlockTop = na
var float bearBlockBottom = na

if bullishBos
    int found = na
    for i = 1 to blockLookback
        if close[i] < open[i] and (high[i] - low[i]) <= atr[i] * blockAtr
            found := i
            break
    if not na(found)
        bullBlockTop := high[found]
        bullBlockBottom := low[found]
        if showBlocks
            box b = box.new(bar_index - found, bullBlockTop, bar_index + 1, bullBlockBottom, extend = extend.right, bgcolor = color.new(color.green, 88), border_color = color.new(color.green, 35))
            array.unshift(bullBlocks, b)
            if array.size(bullBlocks) > maxBlocks
                box.delete(array.pop(bullBlocks))

if bearishBos
    int found = na
    for i = 1 to blockLookback
        if close[i] > open[i] and (high[i] - low[i]) <= atr[i] * blockAtr
            found := i
            break
    if not na(found)
        bearBlockTop := high[found]
        bearBlockBottom := low[found]
        if showBlocks
            box b = box.new(bar_index - found, bearBlockTop, bar_index + 1, bearBlockBottom, extend = extend.right, bgcolor = color.new(color.red, 88), border_color = color.new(color.red, 35))
            array.unshift(bearBlocks, b)
            if array.size(bearBlocks) > maxBlocks
                box.delete(array.pop(bearBlocks))

bool inBullBlock = not na(bullBlockTop) and low <= bullBlockTop and high >= bullBlockBottom
bool inBearBlock = not na(bearBlockTop) and high >= bearBlockBottom and low <= bearBlockTop

//=============================================================================
// LIQUIDITY — equal highs/lows and sweeps
//=============================================================================
float rangeHigh = ta.highest(high[1], liquidityLookback)
float rangeLow = ta.lowest(low[1], liquidityLookback)
bool equalHigh = not na(rangeHigh) and not na(atr) and math.abs(high - rangeHigh) <= atr * equalTolerance
bool equalLow = not na(rangeLow) and not na(atr) and math.abs(low - rangeLow) <= atr * equalTolerance
bool sellSideSweep = not na(rangeLow) and low < rangeLow and close > rangeLow
bool buySideSweep = not na(rangeHigh) and high > rangeHigh and close < rangeHigh

plot(showLiquidity ? rangeHigh : na, "Buy-side liquidity", color = color.new(color.red, 45), style = plot.style_linebr)
plot(showLiquidity ? rangeLow : na, "Sell-side liquidity", color = color.new(color.green, 45), style = plot.style_linebr)
plotshape(showLiquidity and sellSideSweep, "Sell-side liquidity sweep", style = shape.triangleup, location = location.belowbar, color = color.aqua, size = size.tiny, text = "LQ")
plotshape(showLiquidity and buySideSweep, "Buy-side liquidity sweep", style = shape.triangledown, location = location.abovebar, color = color.orange, size = size.tiny, text = "LQ")

//=============================================================================
// SIGNAL SCORING, SL/TP
//=============================================================================
float volumeAvg = ta.sma(volume, 20)
float relVol = volumeAvg > 0 ? volume / volumeAvg : 1
bool bullishCandle = close > open and close > close[1]
bool bearishCandle = close < open and close < close[1]
int buyScore = (structureBias == 1 ? 25 : 0) + (bullishBos ? 20 : 0) + (inBullBlock ? 20 : 0) + (sellSideSweep ? 15 : 0) + (htfBull ? 15 : 0) + (relVol >= 1 ? 5 : 0)
int sellScore = (structureBias == -1 ? 25 : 0) + (bearishBos ? 20 : 0) + (inBearBlock ? 20 : 0) + (buySideSweep ? 15 : 0) + (htfBear ? 15 : 0) + (relVol >= 1 ? 5 : 0)
bool buyBiasOk = not useHtfBias or htfBull
bool sellBiasOk = not useHtfBias or htfBear
bool buySignal = barstate.isconfirmed and bullishCandle and buyBiasOk and buyScore >= minScore and (not requireSweep or sellSideSweep)
bool sellSignal = barstate.isconfirmed and bearishCandle and sellBiasOk and sellScore >= minScore and (not requireSweep or buySideSweep)

var bool buyActive = false
var bool sellActive = false
var float buyEntry = na
var float buyStop = na
var float buyTarget = na
var float sellEntry = na
var float sellStop = na
var float sellTarget = na
if buySignal and (not oneSignalPerSide or not buyActive)
    buyActive := true
    buyEntry := close
    buyStop := close - atr * stopAtr
    buyTarget := close + atr * stopAtr * targetR
if sellSignal and (not oneSignalPerSide or not sellActive)
    sellActive := true
    sellEntry := close
    sellStop := close + atr * stopAtr
    sellTarget := close - atr * stopAtr * targetR
if buyActive and (low <= buyStop or high >= buyTarget)
    buyActive := false
if sellActive and (high >= sellStop or low <= sellTarget)
    sellActive := false

plotshape(buySignal, "MOERAND Ultimate BUY", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, text = "BUY", size = size.small)
plotshape(sellSignal, "MOERAND Ultimate SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, text = "SELL", size = size.small)
plot(showTargets and buyActive ? buyStop : na, "Buy Stop Loss", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(showTargets and buyActive ? buyTarget : na, "Buy Take Profit", color = color.green, style = plot.style_linebr, linewidth = 2)
plot(showTargets and sellActive ? sellStop : na, "Sell Stop Loss", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(showTargets and sellActive ? sellTarget : na, "Sell Take Profit", color = color.green, style = plot.style_linebr, linewidth = 2)

//=============================================================================
// ALERTS — dynamic JSON is compatible with the MOE-AI Worker
//=============================================================================
if enableAlerts and enableWebhook and str.length(webhookSecret) > 0 and buySignal
    alert(f_json("BUY", "MOERAND_ULTIMATE", buyEntry, buyStop, buyTarget, buyScore, time), alert.freq_once_per_bar_close)
if enableAlerts and enableWebhook and str.length(webhookSecret) > 0 and sellSignal
    alert(f_json("SELL", "MOERAND_ULTIMATE", sellEntry, sellStop, sellTarget, sellScore, time), alert.freq_once_per_bar_close)

var bool testSent = false
if not sendWebhookTest
    testSent := false
if sendWebhookTest and not testSent and barstate.isrealtime and enableAlerts and enableWebhook and str.length(webhookSecret) > 0
    float testStop = close - atr
    float testTarget = close + atr * 2
    alert(f_json("BUY", "MOERAND_ULTIMATE_TEST", close, testStop, testTarget, 100, time), alert.freq_once_per_bar)
    testSent := true

alertcondition(buySignal, "MOERAND Ultimate BUY", "MOERAND Ultimate BUY {{ticker}} {{interval}}")
alertcondition(sellSignal, "MOERAND Ultimate SELL", "MOERAND Ultimate SELL {{ticker}} {{interval}}")
alertcondition(sellSideSweep, "MOERAND Ultimate Sell-side Liquidity Sweep", "Sell-side liquidity swept on {{ticker}}")
alertcondition(buySideSweep, "MOERAND Ultimate Buy-side Liquidity Sweep", "Buy-side liquidity swept on {{ticker}}")

//=============================================================================
// INFORMATION PANEL
//=============================================================================
var table panel = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), frame_color = color.new(color.white, 70), frame_width = 1)
if barstate.islast and showPanel
    table.cell(panel, 0, 0, "MOERAND ULTIMATE", bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 1, 0, syminfo.ticker, bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 0, 1, "Structure", text_color = color.white)
    table.cell(panel, 1, 1, structureBias == 1 ? "BULLISH" : structureBias == -1 ? "BEARISH" : "NEUTRAL", text_color = structureBias == 1 ? color.lime : structureBias == -1 ? color.red : color.gray)
    table.cell(panel, 0, 2, "HTF Bias", text_color = color.white)
    table.cell(panel, 1, 2, htfBull ? "BULLISH" : htfBear ? "BEARISH" : "NEUTRAL", text_color = htfBull ? color.lime : htfBear ? color.red : color.gray)
    table.cell(panel, 0, 3, "Buy Score", text_color = color.white)
    table.cell(panel, 1, 3, str.tostring(buyScore) + "/100", text_color = buyScore >= minScore ? color.lime : color.gray)
    table.cell(panel, 0, 4, "Sell Score", text_color = color.white)
    table.cell(panel, 1, 4, str.tostring(sellScore) + "/100", text_color = sellScore >= minScore ? color.red : color.gray)
    table.cell(panel, 0, 5, "Order Blocks", text_color = color.white)
    table.cell(panel, 1, 5, inBullBlock ? "BULLISH" : inBearBlock ? "BEARISH" : "—", text_color = inBullBlock ? color.lime : inBearBlock ? color.red : color.gray)
    table.cell(panel, 0, 6, "Liquidity", text_color = color.white)
    table.cell(panel, 1, 6, sellSideSweep ? "SELL-SIDE SWEPT" : buySideSweep ? "BUY-SIDE SWEPT" : "WATCHING", text_color = sellSideSweep ? color.aqua : buySideSweep ? color.orange : color.gray)
    table.cell(panel, 0, 7, "Relative Volume", text_color = color.white)
    table.cell(panel, 1, 7, str.tostring(relVol, "#.##") + "x", text_color = relVol >= 1 ? color.lime : color.gray)
    table.cell(panel, 0, 8, "Risk", text_color = color.white)
    table.cell(panel, 1, 8, str.tostring(targetR, "#.#") + "R", text_color = color.yellow)
else if barstate.islast and not showPanel
    table.clear(panel, 0, 0, 1, 8)