//@version=6
// MOERAND Simple — long-only companion for the MOE-AI Worker.
// BUY alert opens a position, SELL alert closes it. No stop loss.
// Simple but smart: trend + momentum + volume confirmation with a
// one-position state machine so signals never repeat while in a trade.
indicator("MOERAND Simple", "MOERAND Simple", overlay = true)

//=============================================================================
// SETTINGS
//=============================================================================
string gLogic = "1. Signal Logic"
int emaFastLen = input.int(9, "Fast EMA", minval = 3, maxval = 50, group = gLogic)
int emaSlowLen = input.int(21, "Slow EMA", minval = 5, maxval = 200, group = gLogic)
int trendLen = input.int(50, "Trend EMA (buy filter)", minval = 20, maxval = 400, group = gLogic)
int rsiLen = input.int(14, "RSI Length", minval = 5, maxval = 50, group = gLogic)
float rsiBuyMin = input.float(52, "RSI Minimum For Buy", minval = 40, maxval = 70, group = gLogic)
float rsiExit = input.float(45, "RSI Exit Level", minval = 20, maxval = 55, group = gLogic)
bool useVolumeFilter = input.bool(true, "Require Above-Average Volume For Buy", group = gLogic)

string gExit = "2. Smart Exit"
bool exitOnCross = input.bool(true, "Exit On EMA Cross Down", group = gExit)
bool exitOnRsi = input.bool(true, "Exit On RSI Weakness", group = gExit)
bool exitOnTrendLoss = input.bool(false, "Exit When Price Closes Below Trend EMA", group = gExit)

string gHook = "3. MOE AI Webhook"
bool enableWebhook = input.bool(true, "Enable MOE AI Webhook", group = gHook)
string webhookSecret = input.string("", "MOE Webhook Secret", group = gHook)
bool requestSandbox = input.bool(false, "Request Sandbox Submission", group = gHook)
bool sendWebhookTest = input.bool(false, "Send One-Time Webhook Test", group = gHook)
bool showPanel = input.bool(true, "Show Information Panel", group = gHook)

//=============================================================================
// WEBHOOK JSON — compatible with the MOE-AI Worker webhook route
//=============================================================================
f_num(float n) =>
    str.tostring(n, format.mintick)

f_json(string side, float price, int signalTime) =>
    string msg = "{"
    msg += "\"secret\":\"" + webhookSecret + "\","
    msg += "\"symbol\":\"" + syminfo.ticker + "\","
    msg += "\"side\":\"" + side + "\","
    msg += "\"orderType\":\"MARKET\","
    msg += "\"price\":" + f_num(price) + ","
    msg += "\"source\":\"MOERAND_SIMPLE\","
    msg += "\"signalId\":\"MOERAND_SIMPLE-" + side + "-" + syminfo.ticker + "-" + str.tostring(signalTime) + "\","
    msg += "\"submitSandbox\":" + (requestSandbox ? "true" : "false") + ","
    msg += "\"context\":{\"timeframe\":\"" + timeframe.period + "\"}"
    msg += "}"
    msg

//=============================================================================
// CORE LOGIC
//=============================================================================
float emaFast = ta.ema(close, emaFastLen)
float emaSlow = ta.ema(close, emaSlowLen)
float emaTrend = ta.ema(close, trendLen)
float rsi = ta.rsi(close, rsiLen)
float volumeAvg = ta.sma(volume, 20)
bool volumeOk = not useVolumeFilter or volumeAvg == 0 or volume > volumeAvg

bool crossUp = ta.crossover(emaFast, emaSlow)
bool crossDown = ta.crossunder(emaFast, emaSlow)
bool uptrend = close > emaTrend

// One-position state machine: BUY only when flat, SELL only when in a trade.
var bool inPosition = false
var float entryPrice = na

bool buyCondition = crossUp and uptrend and rsi >= rsiBuyMin and volumeOk
bool exitCondition = (exitOnCross and crossDown) or (exitOnRsi and ta.crossunder(rsi, rsiExit)) or (exitOnTrendLoss and close < emaTrend)

bool buySignal = barstate.isconfirmed and buyCondition and not inPosition
bool sellSignal = barstate.isconfirmed and exitCondition and inPosition

if buySignal
    inPosition := true
    entryPrice := close
if sellSignal
    inPosition := false

//=============================================================================
// VISUALS
//=============================================================================
plot(emaFast, "Fast EMA", color = color.new(color.aqua, 20))
plot(emaSlow, "Slow EMA", color = color.new(color.orange, 20))
plot(emaTrend, "Trend EMA", color = color.new(color.gray, 40), linewidth = 2)
plotshape(buySignal, "MOERAND Simple BUY", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, text = "BUY", size = size.small)
plotshape(sellSignal, "MOERAND Simple SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, text = "SELL", size = size.small)
bgcolor(inPosition ? color.new(color.green, 94) : na)

//=============================================================================
// ALERTS — BUY opens the position, SELL closes it on the Worker
//=============================================================================
if enableWebhook and str.length(webhookSecret) > 0 and buySignal
    alert(f_json("BUY", close, time), alert.freq_once_per_bar_close)
if enableWebhook and str.length(webhookSecret) > 0 and sellSignal
    alert(f_json("SELL", close, time), alert.freq_once_per_bar_close)

var bool testSent = false
if not sendWebhookTest
    testSent := false
if sendWebhookTest and not testSent and barstate.isrealtime and enableWebhook and str.length(webhookSecret) > 0
    alert(f_json("BUY", close, time), alert.freq_once_per_bar)
    testSent := true

alertcondition(buySignal, "MOERAND Simple BUY", "MOERAND Simple BUY {{ticker}} {{interval}}")
alertcondition(sellSignal, "MOERAND Simple SELL", "MOERAND Simple SELL {{ticker}} {{interval}}")

//=============================================================================
// INFORMATION PANEL
//=============================================================================
var table panel = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 15), frame_color = color.new(color.white, 70), frame_width = 1)
if barstate.islast and showPanel
    table.cell(panel, 0, 0, "MOERAND SIMPLE", bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 1, 0, syminfo.ticker, bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 0, 1, "Position", text_color = color.white)
    table.cell(panel, 1, 1, inPosition ? "LONG" : "FLAT", text_color = inPosition ? color.lime : color.gray)
    table.cell(panel, 0, 2, "Entry", text_color = color.white)
    table.cell(panel, 1, 2, inPosition ? str.tostring(entryPrice, format.mintick) : "—", text_color = color.white)
    table.cell(panel, 0, 3, "Trend", text_color = color.white)
    table.cell(panel, 1, 3, uptrend ? "UP" : "DOWN", text_color = uptrend ? color.lime : color.red)
    table.cell(panel, 0, 4, "RSI", text_color = color.white)
    table.cell(panel, 1, 4, str.tostring(rsi, "#.0"), text_color = rsi >= rsiBuyMin ? color.lime : color.gray)
else if barstate.islast and not showPanel
    table.clear(panel, 0, 0, 1, 4)
