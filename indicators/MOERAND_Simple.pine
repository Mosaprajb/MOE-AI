//@version=6
// MOERAND Simple — UT Bot style ATR trailing stop, long-only, for the MOE-AI Worker.
// BUY alert opens a position, SELL alert closes it (the Worker sells the actual held qty).
// No fixed stop loss — the smart ATR trailing stop decides the exit.
indicator("MOERAND Simple", "MOERAND Simple", overlay = true)

//=============================================================================
// SETTINGS
//=============================================================================
string gLogic = "1. Signal Logic (UT Bot style)"
float keyValue = input.float(1.0, "Key Value (sensitivity)", minval = 0.1, step = 0.1, group = gLogic)
int atrPeriod = input.int(10, "ATR Period", minval = 1, group = gLogic)
bool useHeikin = input.bool(false, "Signals From Heikin Ashi Candles", group = gLogic)

string gSession = "2. Trading Session"
bool sessionOnly = input.bool(true, "Open Trades In Regular Session Only", group = gSession)
string sessionWindow = input.session("0830-1500", "Session Window", group = gSession)
string sessionTz = input.string("America/Chicago", "Session Timezone", options = ["America/Chicago", "America/New_York", "America/Los_Angeles", "Asia/Riyadh", "UTC"], group = gSession)

string gHook = "3. MOE AI Webhook"
bool enableWebhook = input.bool(true, "Enable MOE AI Webhook", group = gHook)
string webhookSecret = input.string("", "MOE Webhook Secret", group = gHook)
bool requestSandbox = input.bool(false, "Request Sandbox Submission", group = gHook)
bool sendWebhookTest = input.bool(false, "Send One-Time Webhook Test", group = gHook)
bool showPanel = input.bool(true, "Show Information Panel", group = gHook)

//=============================================================================
// WEBHOOK JSON — compatible with the MOE-AI Worker webhook route
//=============================================================================
f_num(float n) =>
    str.tostring(n, format.mintick)

f_json(string side, float price, int signalTime) =>
    string msg = "{"
    msg += "\"secret\":\"" + webhookSecret + "\","
    msg += "\"symbol\":\"" + syminfo.ticker + "\","
    msg += "\"side\":\"" + side + "\","
    msg += (side == "SELL" ? "\"closePosition\":true," : "")
    msg += "\"orderType\":\"MARKET\","
    msg += "\"price\":" + f_num(price) + ","
    msg += "\"source\":\"MOERAND_SIMPLE\","
    msg += "\"signalId\":\"MOERAND_SIMPLE-" + side + "-" + syminfo.ticker + "-" + str.tostring(signalTime) + "\","
    msg += "\"submitSandbox\":" + (requestSandbox ? "true" : "false") + ","
    msg += "\"context\":{\"timeframe\":\"" + timeframe.period + "\"}"
    msg += "}"
    msg

//=============================================================================
// UT BOT CORE — ATR trailing stop
//=============================================================================
float xATR = ta.atr(atrPeriod)
float nLoss = keyValue * xATR

float src = useHeikin ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead = barmerge.lookahead_off) : close

var float trailingStop = 0.0
float prevStop = nz(trailingStop[1], 0.0)
trailingStop := src > prevStop and src[1] > prevStop ? math.max(prevStop, src - nLoss) :
     src < prevStop and src[1] < prevStop ? math.min(prevStop, src + nLoss) :
     src > prevStop ? src - nLoss : src + nLoss

var int pos = 0
pos := src[1] < prevStop and src > prevStop ? 1 :
     src[1] > prevStop and src < prevStop ? -1 : nz(pos[1], 0)

float ema1 = ta.ema(src, 1)
bool above = ta.crossover(ema1, trailingStop)
bool below = ta.crossover(trailingStop, ema1)

bool buyRaw = src > trailingStop and above
bool sellRaw = src < trailingStop and below

// One-position state machine: BUY only when flat, SELL only when in a trade.
var bool inPosition = false
var float entryPrice = na

// Session gate — BUY only inside the regular session (Mon–Fri); SELL any time.
bool inSession = not sessionOnly or not na(time(timeframe.period, sessionWindow + ":23456", sessionTz))

bool buySignal = barstate.isconfirmed and buyRaw and not inPosition and inSession
bool sellSignal = barstate.isconfirmed and sellRaw and inPosition

if buySignal
    inPosition := true
    entryPrice := close
if sellSignal
    inPosition := false

//=============================================================================
// VISUALS
//=============================================================================
plot(trailingStop, "ATR Trailing Stop", color = pos == 1 ? color.new(color.green, 0) : pos == -1 ? color.new(color.red, 0) : color.new(color.blue, 0), linewidth = 2)
plotshape(buySignal, "MOERAND Simple BUY", style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, text = "BUY", size = size.tiny)
plotshape(sellSignal, "MOERAND Simple SELL", style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, text = "SELL", size = size.tiny)
barcolor(src > trailingStop ? color.new(color.green, 40) : src < trailingStop ? color.new(color.red, 40) : na)
bgcolor(inPosition ? color.new(color.green, 94) : na)

//=============================================================================
// ALERTS — BUY opens the position, SELL closes it on the Worker
//=============================================================================
if enableWebhook and str.length(webhookSecret) > 0 and buySignal
    alert(f_json("BUY", close, time), alert.freq_once_per_bar_close)
if enableWebhook and str.length(webhookSecret) > 0 and sellSignal
    alert(f_json("SELL", close, time), alert.freq_once_per_bar_close)

var bool testSent = false
if not sendWebhookTest
    testSent := false
if sendWebhookTest and not testSent and barstate.isrealtime and enableWebhook and str.length(webhookSecret) > 0
    alert(f_json("BUY", close, time), alert.freq_once_per_bar)
    testSent := true

alertcondition(buySignal, "MOERAND Simple BUY", "MOERAND Simple BUY {{ticker}} {{interval}}")
alertcondition(sellSignal, "MOERAND Simple SELL", "MOERAND Simple SELL {{ticker}} {{interval}}")

//=============================================================================
// INFORMATION PANEL
//=============================================================================
var table panel = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 15), frame_color = color.new(color.white, 70), frame_width = 1)
if barstate.islast and showPanel
    table.cell(panel, 0, 0, "MOERAND SIMPLE", bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 1, 0, syminfo.ticker, bgcolor = color.new(color.blue, 65), text_color = color.white)
    table.cell(panel, 0, 1, "Position", text_color = color.white)
    table.cell(panel, 1, 1, inPosition ? "LONG" : "FLAT", text_color = inPosition ? color.lime : color.gray)
    table.cell(panel, 0, 2, "Entry", text_color = color.white)
    table.cell(panel, 1, 2, inPosition ? str.tostring(entryPrice, format.mintick) : "—", text_color = color.white)
    table.cell(panel, 0, 3, "Trailing Stop", text_color = color.white)
    table.cell(panel, 1, 3, str.tostring(trailingStop, format.mintick), text_color = pos == 1 ? color.lime : color.red)
    table.cell(panel, 0, 4, "Session", text_color = color.white)
    table.cell(panel, 1, 4, inSession ? "OPEN" : "CLOSED (no new trades)", text_color = inSession ? color.lime : color.orange)
else if barstate.islast and not showPanel
    table.clear(panel, 0, 0, 1, 4)
